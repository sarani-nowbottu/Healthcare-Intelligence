# AI-Powered Healthcare Policy Intelligence & Prediction System
# Environment Configuration Template

# Express Backend Port
PORT=5000

# Flask Service URL
FLASK_SERVICE_URL=http://localhost:5001

# Flask Port
FLASK_PORT=5001

# JWT Secret & Expiry
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# SQLite Database Storage
DB_PATH=./healthcare_system.db

# Optional PostgreSQL connection (used when DATABASE_URL is set)
DATABASE_URL=
DATABASE_SSL=false

# Google Gemini API Key (Optional for live generation; local grounded index functions offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend API base URL (leave blank for local Vite proxy)
VITE_API_BASE_URL=
